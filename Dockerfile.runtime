# syntax=docker/dockerfile:1

# rs-http-apilab runtime-only image.
#
# Instead of compiling (Dockerfile), this image downloads the pinned
# release binary from GitHub Releases and verifies it with --checksum.
# Fast to build; the binary is dynamically linked against glibc, so the
# runtime must provide a compatible glibc (bookworm = 2.36).
#
# Update RELEASE_TAG and RELEASE_SHA256 together on every new release
# (the checksum comes from the release's SHA256SUMS file).

ARG RELEASE_TAG=v1.0.0
ARG RELEASE_SHA256=e2a216aa596914ce72663e6b111bf24192cb59216ddbe84c76d5c352c64e8cec

FROM debian:bookworm-slim AS runtime
ARG RELEASE_TAG
ARG RELEASE_SHA256

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates curl \
	&& rm -rf /var/lib/apt/lists/* \
	&& useradd --uid 10001 --system --no-create-home rsapilab

ADD --checksum=sha256:${RELEASE_SHA256} \
	https://github.com/Esl1h/rs-http-apilab/releases/download/${RELEASE_TAG}/rs-http-apilab-linux-amd64 \
	/app/rs-http-apilab

RUN chmod +x /app/rs-http-apilab

USER 10001:10001
ENV PORT=8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
	CMD curl -fsS "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["/app/rs-http-apilab"]
